# Providers (at least one). All have free tiers.
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (also used for cache embeddings)
OPENROUTER_API_KEY=      # https://openrouter.ai/settings/keys  (optional)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai            (optional)

# Shared state. Without these Sluice runs with in-memory state (fine for local use).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=     # index: 768 dimensions, COSINE
UPSTASH_VECTOR_REST_TOKEN=

# Client keys for /v1: "name:secret,name:secret". Empty = no auth (local only).
SLUICE_API_KEYS=

# Tuning (defaults shown)
SLUICE_CACHE_THRESHOLD=        # empty = per-model calibrated thresholds (0.97 embedding-2, 0.98 embedding-001)
SLUICE_CACHE_MAX_TEMPERATURE=0.5
SLUICE_KEY_RPM=60
SLUICE_PLAYGROUND_PER_HOUR=20
SLUICE_PLAYGROUND_PER_DAY=400
SLUICE_GUARD=1
